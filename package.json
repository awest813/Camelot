{
  "name": "camelot",
  "author": "Andrei Stepanov <eldinor@gmail.com> (https://babylonpress.org/)",
  "contributors": [
    "minibao (https://github.com/minibao/babylon-vite)"
  ],
  "private": true,
  "description": "Arthurian open-world RPG",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "check:guardrails": "node tools/check-guardrails.mjs",
    "check:bundle": "node tools/check-bundle.mjs",
    "dev:e2e": "vite --config vite.e2e.config.ts",
    "assets:filler": "node tools/generate-filler-assets.mjs",
    "assets:quaternius": "node tools/import-quaternius.mjs",
    "assets:grade": "node tools/grade-kaykit-textures.mjs",
    "assets:lods": "node tools/build-character-lods.mjs",
    "desktop": "desktop/node_modules/.bin/electron desktop/main.mjs",
    "desktop:dev": "CAMELOT_DEV_SERVER=http://127.0.0.1:8088 desktop/node_modules/.bin/electron desktop/main.mjs",
    "desktop:check": "node --check desktop/main.mjs && node --check desktop/preload.mjs && node --check desktop/steam.mjs && node --check desktop/paths.mjs",
    "desktop:pack": "npm run build && desktop/node_modules/.bin/electron-builder --config desktop/electron-builder.json --linux dir"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.59.1",
    "@types/delaunator": "^5.0.3",
    "@types/node": "^24.7.0",
    "jsdom": "^28.1.0",
    "meshoptimizer": "^1.3.0",
    "naga-wasm": "^30.2.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^6.2.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-glsl": "^1.5.4",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@babylonjs/core": "^8.52.1",
    "@babylonjs/gui": "^8.52.1",
    "@babylonjs/havok": "^1.3.10",
    "@babylonjs/inspector": "^8.52.1",
    "@babylonjs/loaders": "^8.52.1",
    "@babylonjs/materials": "^8.52.1",
    "@babylonjs/post-processes": "^8.52.1",
    "bitecs": "^0.4.0",
    "delaunator": "^5.1.0",
    "preact": "^10.29.8",
    "recast-detour": "^1.5.0",
    "simplex-noise": "^4.0.3"
  }
}
